# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored -- it will NOT be committed or published.

# --- Modbus / Inverter connection ---
INVERTER_IP=192.168.1.100
MODBUS_PORT=502
MODBUS_SLAVE_ID=1
MODBUS_TIMEOUT=3.0

# Register map (only change if your inverter uses a different layout)
REGISTER_ADDRESS=4097
REGISTER_COUNT=60

# --- Polling ---
POLL_DELAY=5.0
ERROR_RETRY_DELAY=5.0

# --- Powercut detection ---
# Consecutive daytime read errors before a powercut is recorded.
POWERCUT_ERROR_THRESHOLD=5
# Consecutive zero-production + check-IP-unreachable reads before a powercut
# is recorded (guards against a single flaky ping).
POWERCUT_ZERO_THRESHOLD=3
# Optional: IP of an always-on device on the same power circuit (e.g. a WiFi
# extender). Used for both powercut detection paths: successful reads showing
# ~zero production only count as an outage when this IP is unreachable, and
# after N consecutive Modbus errors a cut is recorded only when this IP AND
# the inverter IP are both unreachable. Leave empty to record a powercut after
# N consecutive errors unconditionally (zero-production detection disabled).
POWERCUT_CHECK_IP=

# --- Storage ---
DB_PATH=solar_data.db

# --- Long-term data management ---
# Days of full-resolution data to keep; older rows are downsampled into
# hourly/daily aggregate tables and then deleted.
RETENTION_DAYS=60
# Local hour (0-23) at which the daily maintenance task runs.
MAINTENANCE_HOUR=3
# Allow the weekly VACUUM/ANALYZE pass to reclaim space and refresh stats.
ENABLE_VACUUM=true

# --- Location (for sunrise/sunset night-mode logic) ---
CITY=New Delhi
COUNTRY=India
TIMEZONE=Asia/Kolkata
LATITUDE=28.6139
LONGITUDE=77.2090

# --- Weather (top bar) ---
# Optional OpenWeatherMap API key -- used as the primary weather provider.
# Leave empty to use Open-Meteo (no key required).
OPENWEATHER_API_KEY=
# Historical daily weather (Weather Impact panel) fetched from the free
# Open-Meteo Archive API during the nightly maintenance run. Set to false
# to opt out -- no archive requests are made and the panel hides itself.
WEATHER_HISTORY_ENABLED=true

# --- Savings & impact (sidebar panel) ---
# Flat electricity tariff per kWh used to estimate money saved. Figures are
# always computed live from energy x this rate (past rates are not stored).
# Set to 0 (or leave empty) to disable and hide the Savings & Impact panel.
ELECTRICITY_TARIFF=8.0
# Currency symbol shown with savings figures.
CURRENCY_SYMBOL=₹
# Grid CO2 intensity (kg CO2 per kWh) for the offset estimate; default is
# roughly the CEA Indian grid average. Adjust to track revisions.
GRID_CO2_KG_PER_KWH=0.72

# --- Server ---
HOST=0.0.0.0
PORT=8000
